# Non-secret runtime defaults ONLY. Secret VALUES (MINECRAFT_RCON_PASSWORD,
# CS2_RCON_PASSWORD, R2 keys, CLOUDFLARE_API_TOKEN, …) live in the host secrets
# file — see secrets.env.example. Compose layers that file on top of this, and
# env.js lets process.env win, so secrets never need to live in the repo.

PORT=3000
HOST=127.0.0.1
DB_PATH=./data/gamertown.sqlite
SESSION_KEY_PATH=./data/session-key
NODE_ENV=production

# Public address players use to reach the game servers (port-forwarded WAN IP or
# a domain). Only used to render the join strings shown on the control panel.
PUBLIC_HOST=104.177.95.216

# ── Game-server control (Docker host-driver) ──────────────────────────────────
# Blank → the control panel is disabled (/api/servers -> 503). The
# servers.compose.yml overlay sets this to the scoped socket-proxy
# (tcp://docker-proxy:2375) for the app; leave it blank/commented here so running
# ONLY docker-compose.yml doesn't point the app at a proxy that isn't up.
#DOCKER_HOST=tcp://docker-proxy:2375
