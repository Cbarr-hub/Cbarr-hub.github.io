# Non-secret runtime defaults ONLY. Secret VALUES (PVE_TOKEN_SECRET,
# MINECRAFT_RCON_PASSWORD, R2 keys, CLOUDFLARE_API_TOKEN, …) live in the host
# secrets file — see secrets.env.example. Compose layers that file on top of this,
# and env.js lets process.env win, so secrets never need to live in the repo.

PORT=3000
HOST=127.0.0.1
DB_PATH=./data/gamertown.sqlite
SESSION_KEY_PATH=./data/session-key
NODE_ENV=production

# ── Game-server control (Proxmox VE API) ──────────────────────────────────────
# Leave PVE_TOKEN_* blank to disable the control panel (/api/servers -> 503).
# Create a token at: Datacenter -> Permissions -> API Tokens.
# PVE_TOKEN_SECRET is a secret → set it in the host secrets file, not here.
PVE_API_URL=https://192.168.1.109:8006
PVE_NODE=pve
PVE_TOKEN_ID=gamertown@pve!serverctl
# Proxmox uses a self-signed cert by default; flip to true once a trusted cert
# is in place.
PVE_TLS_REJECT_UNAUTHORIZED=false
# Public address players use to reach the game servers (port-forwarded WAN IP or
# a domain). Only used to render the join strings shown on the control panel.
PUBLIC_HOST=104.177.95.216

# ── Docker host-driver (game servers as containers) ───────────────────────────
# Blank → the Docker backend is disabled (registry entries with backend:'docker'
# are skipped), mirroring the PVE-blank degrade. Points at the scoped socket-proxy.
DOCKER_HOST=tcp://docker-proxy:2375
