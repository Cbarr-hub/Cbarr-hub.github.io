# Local Claude Code state — settings + worktree checkouts. Never commit:
# .claude/worktrees/ holds full working copies of the repo.
.claude/

# macOS junk
.DS_Store

# Logs
*.log

# Local secrets — NEVER commit (this is a public *.github.io repo)
SECRETS.local.md
*.local
.secrets
# runtime env — root project .env has GSLTs, plus backend/.env (NOT .env.example)
.env
# host secrets file, if ever copied into the repo dir
secrets.env

# stray root lockfile — there is no root package.json (the app lockfile is backend/)
/package-lock.json

# gt prod rollback anchor (written on the keeper by tools/gt.sh prod)
.last-deploy

# BlueMap runtime-generated config. Keep the hand-authored webapp + file-storage
# config tracked so 3D LOD/storage behavior is deterministic across deploys.
docker/bluemap/config/storages/*
!docker/bluemap/config/storages/
!docker/bluemap/config/storages/file.conf
docker/bluemap/config/packs/
