# Gamertown app/Caddy secrets template.
#
# Copy this file to the Docker host as /etc/gamertown/secrets.env, fill it in,
# and keep it mode 600. Compose injects this file into the app and Caddy
# containers, so do not put host-only backup credentials here.
#
# Project-level Compose interpolation belongs in /root/gamertown/.env instead.
# It must include the same RCON password values below plus CS2_GSLT, GMOD_GSLT,
# PROPHUNT_GSLT, GMOD_WORKSHOP_COLLECTION, MC_LEVEL, SKIP_CSS, and related game
# boot knobs.
#
# R2 backup credentials belong only in the host root rclone config:
# /root/.config/rclone/rclone.conf.

# Caddy / edge.
# Local default can be left unset: Caddyfile falls back to localhost + tls internal.
# Production normally uses a Cloudflare Origin cert mounted at /etc/caddy/certs.
#SITE_ADDRESS=gamertown.solutions, www.gamertown.solutions
#CADDY_TLS=tls /etc/caddy/certs/gamertown.solutions.pem /etc/caddy/certs/gamertown.solutions.key

# Optional DNS-01 setup if you later replace the Origin cert path with Caddy DNS.
#CLOUDFLARE_API_TOKEN=

# RCON passwords shared by the app and game containers.
MINECRAFT_RCON_PASSWORD=
CS2_RCON_PASSWORD=
GMOD_RCON_PASSWORD=
PROPHUNT_RCON_PASSWORD=

# Optional Steam Web API key. CS map collection import and auto-name work with
# keyless public endpoints, so leave unset unless Steam starts requiring a key.
#STEAM_API_KEY=

# Optional BlueMap CPU auto-tuning knobs. Defaults:
# - while any player is online: cap BlueMap to 2 CPUs
# - while empty: cap BlueMap to host CPU count minus 4 reserved CPUs
# - wait 5 minutes after the last player leaves before ramping up
#BLUEMAP_RESOURCE_AUTOTUNE=1
#BLUEMAP_ACTIVE_CPUS=2
#BLUEMAP_IDLE_CPUS=0
#BLUEMAP_RESERVED_CPUS=4
#BLUEMAP_IDLE_DELAY_SECONDS=300

# Optional BlueMap live player markers. The app writes players.json + per-UUID
# skin heads into the bluemap container so online Minecraft players show as map
# markers (needs MINECRAFT_RCON_PASSWORD — positions come over RCON). Skins are
# fetched from a public head service keyed on the Mojang UUID.
#BLUEMAP_PLAYERS_AUTOWRITE=1
#BLUEMAP_PLAYERS_POLL_MS=2000
#BLUEMAP_SKIN_BASE=https://mc-heads.net/avatar
