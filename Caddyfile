# Gamertown reverse proxy + static site for the Docker stack.
#
# Defaults: SITE_ADDRESS=localhost + CADDY_TLS="tls internal" gives local
# self-signed HTTPS. Production sets SITE_ADDRESS and a Cloudflare Origin cert in
# the host secrets file, then bind-mounts certs to /etc/caddy/certs.

{$SITE_ADDRESS:localhost} {
	encode gzip

	# Never serve backend source / infra files that ride along in the image.
	@infra path /backend/* /Dockerfile* /docker-compose* /Caddyfile* /*.md
	handle @infra {
		respond 403
	}

	# API -> the backend container.
	handle /api/* {
		reverse_proxy app:3000
	}

	# Public assets (sign-in page + static media) served WITHOUT the auth gate.
	# `no-cache` = browsers may store but MUST revalidate (ETag → cheap 304 when
	# unchanged). Without it, Cloudflare stamps a ~4h browser-cache TTL on these, so
	# a deploy that changes a JS module leaves clients on a stale copy — fresh HTML
	# (no-store, below) importing an old module → "missing export" / blank page.
	# Revalidation makes a deploy take effect on the next load instead.
	@public path /signin.html *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.webp *.mp4
	handle @public {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	# Everything else is gated behind login. Caddy asks the app's /api/auth/gate,
	# which returns 204 when logged in or redirects to /signin.html.
	handle {
		forward_auth app:3000 {
			uri /api/auth/gate
		}
		header Cache-Control "no-store"
		root * /srv
		try_files {path} {path}.html /index.html
		file_server
	}

	{$CADDY_TLS:tls internal}
}
