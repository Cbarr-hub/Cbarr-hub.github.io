# Build context for the Caddy image (Dockerfile.caddy, context = repo root).
# Keep the served *.html / *.css / *.js / *.png — they ARE the site. Exclude
# everything that must never be web-served or baked into an image.

.git
.github
.claude
.dockerignore

# Backend source is served by the `app` container, not Caddy — keep it out of /srv.
backend
node_modules
**/node_modules

# Secrets must never enter any image (they live in the host secrets file).
.env
*.local
.secrets
SECRETS.local.md
secrets.env

# Build artifacts / junk. NOTE: excluding Dockerfile* / docker-compose*.yml here
# only keeps them OUT OF /srv (so they're never web-served) — it does NOT stop the
# Caddy image from building. The build's Dockerfile (Dockerfile.caddy, named via the
# compose `dockerfile:` key) is sent to the daemon separately from the context, so
# .dockerignore can't hide it from itself; only the later `COPY . /srv` is filtered.
# The Caddyfile is deliberately NOT excluded — `COPY Caddyfile …` needs it in context.
Dockerfile*
docker-compose*.yml
*.log
.DS_Store
