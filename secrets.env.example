# Gamertown secrets — TEMPLATE. Copy to the host, fill in, lock down:
#
#   sudo install -D -m 600 secrets.env.example /etc/gamertown/secrets.env
#   sudo $EDITOR /etc/gamertown/secrets.env
#
# This file (the *.example) is the only secrets-shaped file tracked in the repo,
# and it holds NO real values. The real file lives OUTSIDE the repo; Compose loads
# it via env_file (see docker-compose.yml). Override its path with GT_SECRETS_FILE.
# Back it up with tools/secrets-backup.sh (age-encrypted → R2).

# ── Caddy: real TLS cert via Let's Encrypt DNS-01 (optional) ──────────────────
# Leave all three unset to run with a self-signed cert (tls internal, localhost).
# To get a real cert:
#   SITE_ADDRESS=gamertown.example.com
#   CLOUDFLARE_API_TOKEN=cf_dns_edit_token_for_the_zone
#   CADDY_TLS=tls { dns cloudflare {env.CLOUDFLARE_API_TOKEN} }
#SITE_ADDRESS=
#CLOUDFLARE_API_TOKEN=
#CADDY_TLS=tls { dns cloudflare {env.CLOUDFLARE_API_TOKEN} }

# ── App: containerized game servers ───────────────────────────────────────────
# RCON passwords for the Dockerized game servers (shared by the app + container).
MINECRAFT_RCON_PASSWORD=
CS2_RCON_PASSWORD=
# GMOD/TTT + Prop Hunt (the docker/gmod image seeds these into the game cfg's
# rcon_password; the app reaches RCON over TCP with the same value).
GMOD_RCON_PASSWORD=
PROPHUNT_RCON_PASSWORD=
# Factorio's RCON password is auto-generated by the image into /factorio/config/rconpw
# (the app reads it), so it needs no entry here.

# ── Backups: Cloudflare R2 (used by tools/*-backup.sh and docker-game backups) ─
# R2 API token scoped to the gamertown-backups bucket. Restore needs a SEPARATE
# read-only token kept in your password manager (see the DR section in the plan).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gamertown-backups

# ── Steam Game Server Login Tokens (GSLT) ─────────────────────────────────────
# CS2_GSLT powers the Dockerized CS2 public server (SRCDS_TOKEN). GMOD/Prop Hunt
# tokens are consumed on their VMs today; kept here as the single source of truth
# (retired from SECRETS.local.md) that survives a host rebuild.
CS2_GSLT=
GMOD_GSLT=
PROPHUNT_GSLT=
